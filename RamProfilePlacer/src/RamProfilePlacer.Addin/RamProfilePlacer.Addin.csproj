<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net48</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>12</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>x64</Platforms>
    <AssemblyName>RamProfilePlacer.Addin</AssemblyName>
    <RootNamespace>RamProfilePlacer.Addin</RootNamespace>
    <UseWPF>true</UseWPF>
    <!-- Не копировать Revit DLL в выходную папку -->
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <!--
    Revit API DLL. Если установка нестандартная, передайте путь через:
      dotnet build /p:RevitInstallPath="D:\Revit2026"
    Приоритет: Revit 2026 → 2024.
  -->
  <PropertyGroup>
    <RevitInstallPath Condition="'$(RevitInstallPath)' == '' And Exists('C:\Program Files\Autodesk\Revit 2026')">C:\Program Files\Autodesk\Revit 2026</RevitInstallPath>
    <RevitInstallPath Condition="'$(RevitInstallPath)' == ''">C:\Program Files\Autodesk\Revit 2024</RevitInstallPath>
  </PropertyGroup>

  <!-- Версия Revit (определяется из пути установки) -->
  <PropertyGroup>
    <RevitVersion>2024</RevitVersion>
    <RevitVersion Condition="$(RevitInstallPath.Contains('2026'))">2026</RevitVersion>
  </PropertyGroup>

  <!-- Запуск Revit.exe при нажатии F5 в Visual Studio -->
  <PropertyGroup>
    <StartAction>Program</StartAction>
    <StartProgram>$(RevitInstallPath)\Revit.exe</StartProgram>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="RevitAPI">
      <HintPath>$(RevitInstallPath)\RevitAPI.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>$(RevitInstallPath)\RevitAPIUI.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RamProfilePlacer.Core\RamProfilePlacer.Core.csproj" />
  </ItemGroup>

  <!--
    После каждой сборки разворачивает .addin манифест в папку Revit.
    Assembly указывает прямо на папку сборки — копировать DLL не нужно.
    Работает только если Revit установлен (Revit.exe найден).
    ВАЖНО: используем AfterTargets="Build", а не Name="AfterBuild" —
    в SDK-стиле стандартное имя AfterBuild переопределяется самим SDK.
  -->
  <Target Name="DeployRevitAddinManifest"
          AfterTargets="Build"
          Condition="Exists('$(RevitInstallPath)\Revit.exe')">
    <PropertyGroup>
      <_RevitAddinsDir>$(AppData)\Autodesk\Revit\Addins\$(RevitVersion)</_RevitAddinsDir>
    </PropertyGroup>
    <MakeDir Directories="$(_RevitAddinsDir)" />
    <ItemGroup>
      <!-- XML-декларация опущена: MSBuild трактует '?' как glob-маску и дропает строку.
           Revit грузит .addin без <?xml?> нормально. -->
      <_AddinLines Include="&lt;RevitAddIns&gt;" />
      <_AddinLines Include="  &lt;AddIn Type=&quot;Application&quot;&gt;" />
      <_AddinLines Include="    &lt;Name&gt;RamProfilePlacer&lt;/Name&gt;" />
      <_AddinLines Include="    &lt;Assembly&gt;$(TargetPath)&lt;/Assembly&gt;" />
      <_AddinLines Include="    &lt;AddInId&gt;C3F4A6B7-1234-4D5E-9876-ABCDEF012345&lt;/AddInId&gt;" />
      <_AddinLines Include="    &lt;FullClassName&gt;RamProfilePlacer.Addin.Application&lt;/FullClassName&gt;" />
      <_AddinLines Include="    &lt;VendorId&gt;RAM_Engineering&lt;/VendorId&gt;" />
      <!-- '&' в Include-значении: ';' внутри '&amp;' MSBuild трактует как разделитель элементов.
           Используем 'and' чтобы обойти это ограничение. -->
      <_AddinLines Include="    &lt;VendorDescription&gt;Rock and Mill (РАМ Инжиниринг), BIM Department&lt;/VendorDescription&gt;" />
      <_AddinLines Include="  &lt;/AddIn&gt;" />
      <_AddinLines Include="&lt;/RevitAddIns&gt;" />
    </ItemGroup>
    <WriteLinesToFile
        File="$(_RevitAddinsDir)\RamProfilePlacer.addin"
        Lines="@(_AddinLines)"
        Overwrite="true"
        Encoding="UTF-8" />
    <Message Text="[RamProfilePlacer] Манифест развёрнут: $(_RevitAddinsDir)\RamProfilePlacer.addin" Importance="high" />
  </Target>

  <!-- При очистке (Clean) удаляет .addin из папки Revit -->
  <Target Name="CleanRevitAddinManifest" AfterTargets="Clean">
    <PropertyGroup>
      <_RevitAddinsDir>$(AppData)\Autodesk\Revit\Addins\$(RevitVersion)</_RevitAddinsDir>
    </PropertyGroup>
    <Delete Files="$(_RevitAddinsDir)\RamProfilePlacer.addin" />
  </Target>

</Project>
