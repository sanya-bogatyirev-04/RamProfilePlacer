<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net48</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>12</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>x64</Platforms>
    <AssemblyName>RamProfilePlacer.Addin</AssemblyName>
    <RootNamespace>RamProfilePlacer.Addin</RootNamespace>
    <UseWPF>true</UseWPF>
    <!-- Не копировать Revit DLL в выходную папку -->
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <!--
    Revit API DLL. Если установка нестандартная, передайте путь через:
      dotnet build /p:RevitInstallPath="D:\Revit2026"
    Приоритет: Revit 2026 → 2024.
  -->
  <PropertyGroup>
    <RevitInstallPath Condition="'$(RevitInstallPath)' == '' And Exists('C:\Program Files\Autodesk\Revit 2026')">C:\Program Files\Autodesk\Revit 2026</RevitInstallPath>
    <RevitInstallPath Condition="'$(RevitInstallPath)' == ''">C:\Program Files\Autodesk\Revit 2024</RevitInstallPath>
  </PropertyGroup>

  <!-- Версия Revit (определяется из пути установки) -->
  <PropertyGroup>
    <RevitVersion>2024</RevitVersion>
    <RevitVersion Condition="$(RevitInstallPath.Contains('2026'))">2026</RevitVersion>
  </PropertyGroup>

  <!-- Запуск Revit.exe при нажатии F5 в Visual Studio -->
  <PropertyGroup>
    <StartAction>Program</StartAction>
    <StartProgram>$(RevitInstallPath)\Revit.exe</StartProgram>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="RevitAPI">
      <HintPath>$(RevitInstallPath)\RevitAPI.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>$(RevitInstallPath)\RevitAPIUI.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RamProfilePlacer.Core\RamProfilePlacer.Core.csproj" />
  </ItemGroup>

  <!--
    После каждой сборки разворачивает .addin манифест в папки Revit.
    Отдельный таргет для каждой версии — оба выполняются если обе версии установлены.
    Assembly указывает прямо на папку сборки — копировать DLL не нужно.
    ВАЖНО: AfterTargets="Build", а не Name="AfterBuild" —
    в SDK-стиле стандартное имя AfterBuild переопределяется самим SDK.
    NOTE: XML-декларация <?xml?> опущена — MSBuild трактует '?' как glob и дропает строку.
          Revit грузит .addin без неё нормально.
    NOTE: '&' в Include-значении: ';' внутри '&amp;' — MSBuild трактует как разделитель элементов.
          Используем 'and' вместо '&' в VendorDescription.
  -->
  <Target Name="DeployRevitAddinManifest2024"
          AfterTargets="Build"
          Condition="Exists('C:\Program Files\Autodesk\Revit 2024\Revit.exe')">
    <PropertyGroup>
      <_Addins2024Dir>$(AppData)\Autodesk\Revit\Addins\2024</_Addins2024Dir>
    </PropertyGroup>
    <MakeDir Directories="$(_Addins2024Dir)" />
    <ItemGroup>
      <_AddinLines2024 Include="&lt;RevitAddIns&gt;" />
      <_AddinLines2024 Include="  &lt;AddIn Type=&quot;Application&quot;&gt;" />
      <_AddinLines2024 Include="    &lt;Name&gt;RamProfilePlacer&lt;/Name&gt;" />
      <_AddinLines2024 Include="    &lt;Assembly&gt;$(TargetPath)&lt;/Assembly&gt;" />
      <_AddinLines2024 Include="    &lt;AddInId&gt;C3F4A6B7-1234-4D5E-9876-ABCDEF012345&lt;/AddInId&gt;" />
      <_AddinLines2024 Include="    &lt;FullClassName&gt;RamProfilePlacer.Addin.Application&lt;/FullClassName&gt;" />
      <_AddinLines2024 Include="    &lt;VendorId&gt;RAM_Engineering&lt;/VendorId&gt;" />
      <_AddinLines2024 Include="    &lt;VendorDescription&gt;Rock and Mill (РАМ Инжиниринг), BIM Department&lt;/VendorDescription&gt;" />
      <_AddinLines2024 Include="  &lt;/AddIn&gt;" />
      <_AddinLines2024 Include="&lt;/RevitAddIns&gt;" />
    </ItemGroup>
    <WriteLinesToFile
        File="$(_Addins2024Dir)\RamProfilePlacer.addin"
        Lines="@(_AddinLines2024)"
        Overwrite="true"
        Encoding="UTF-8" />
    <Message Text="[RamProfilePlacer] Манифест развёрнут → Revit 2024: $(_Addins2024Dir)\RamProfilePlacer.addin" Importance="high" />
  </Target>

  <Target Name="DeployRevitAddinManifest2026"
          AfterTargets="Build"
          Condition="Exists('C:\Program Files\Autodesk\Revit 2026\Revit.exe')">
    <PropertyGroup>
      <_Addins2026Dir>$(AppData)\Autodesk\Revit\Addins\2026</_Addins2026Dir>
    </PropertyGroup>
    <MakeDir Directories="$(_Addins2026Dir)" />
    <ItemGroup>
      <_AddinLines2026 Include="&lt;RevitAddIns&gt;" />
      <_AddinLines2026 Include="  &lt;AddIn Type=&quot;Application&quot;&gt;" />
      <_AddinLines2026 Include="    &lt;Name&gt;RamProfilePlacer&lt;/Name&gt;" />
      <_AddinLines2026 Include="    &lt;Assembly&gt;$(TargetPath)&lt;/Assembly&gt;" />
      <_AddinLines2026 Include="    &lt;AddInId&gt;C3F4A6B7-1234-4D5E-9876-ABCDEF012345&lt;/AddInId&gt;" />
      <_AddinLines2026 Include="    &lt;FullClassName&gt;RamProfilePlacer.Addin.Application&lt;/FullClassName&gt;" />
      <_AddinLines2026 Include="    &lt;VendorId&gt;RAM_Engineering&lt;/VendorId&gt;" />
      <_AddinLines2026 Include="    &lt;VendorDescription&gt;Rock and Mill (РАМ Инжиниринг), BIM Department&lt;/VendorDescription&gt;" />
      <_AddinLines2026 Include="  &lt;/AddIn&gt;" />
      <_AddinLines2026 Include="&lt;/RevitAddIns&gt;" />
    </ItemGroup>
    <WriteLinesToFile
        File="$(_Addins2026Dir)\RamProfilePlacer.addin"
        Lines="@(_AddinLines2026)"
        Overwrite="true"
        Encoding="UTF-8" />
    <Message Text="[RamProfilePlacer] Манифест развёрнут → Revit 2026: $(_Addins2026Dir)\RamProfilePlacer.addin" Importance="high" />
  </Target>

  <!-- При очистке (Clean) удаляет .addin из обеих папок Revit -->
  <Target Name="CleanRevitAddinManifest" AfterTargets="Clean">
    <Delete Files="$(AppData)\Autodesk\Revit\Addins\2024\RamProfilePlacer.addin" />
    <Delete Files="$(AppData)\Autodesk\Revit\Addins\2026\RamProfilePlacer.addin" />
  </Target>

</Project>
