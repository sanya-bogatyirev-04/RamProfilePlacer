<?xml version="1.0" encoding="utf-8"?>
<!--
  Манифест плагина для Revit 2026.
  Скопируйте этот файл в:
    %APPDATA%\Autodesk\Revit\Addins\2026\RamProfilePlacer.addin
  Путь к Assembly скорректируйте под вашу папку установки.
-->
<RevitAddIns>

  <!-- Приложение (лента + кнопка) -->
  <AddIn Type="Application">
    <Name>RamProfilePlacer</Name>
    <Assembly>путь\к\RamProfilePlacer.Addin.dll</Assembly>
    <AddInId>C3F4A6B7-1234-4D5E-9876-ABCDEF012345</AddInId>
    <FullClassName>RamProfilePlacer.Addin.Application</FullClassName>
    <VendorId>RAM_Engineering</VendorId>
    <VendorDescription>Rock &amp; Mill (РАМ Инжиниринг), BIM Department</VendorDescription>
  </AddIn>

</RevitAddIns>
